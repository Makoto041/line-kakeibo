rules_version = '2';

// ============================================================================
// Firestore セキュリティルール — 認証・所有者ベース
// ----------------------------------------------------------------------------
// 認証モデル（LIFF→Firebase カスタムトークン認証 PR と対応。契約を変更しない）:
//   - request.auth.uid            = 安定した Firebase アプリ UID（appUid）
//   - request.auth.token.lineId   = 検証済みの LINE userId（カスタムクレーム）
// 既存ドキュメントは各ドキュメントの `lineId` フィールドで所有者を表す。
// したがって所有者判定 = 「サインイン済み かつ resource.data.lineId == token.lineId」。
// 匿名フォールバックのユーザーは request.auth != null だが lineId クレームを持たない
// ため、所有者判定・doc-id 判定の双方に一致せず、フェイルセーフに拒否される。
//
// 重要: サーバー側の Bot は Firebase Admin SDK を使用しており、Admin SDK は
// これらのルールを完全にバイパスする。したがって Bot 経由の書き込み
// （グループ作成・メンバー管理・立替精算・カテゴリ等）はここで拒否しても影響しない。
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- ヘルパー -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    // 検証済みの LINE ユーザーとしてサインインしているか。
    // 匿名サインインは公開 API キーだけで誰でも作れるため、isSignedIn() は実質
    // 「誰でも」と同義になる。LINE 本人確認を経たセッションだけが lineId クレームを
    // 持つので、他人のデータに触れうる条件では必ずこちらを使うこと。
    function isLineUser() {
      return isSignedIn() && request.auth.token.get('lineId', null) != null;
    }
    // 検証済み LINE userId（カスタムクレーム）。匿名では null。
    // クレームを持たないトークンで token.lineId を直接参照すると評価エラー
    // （結果は拒否だがエラーログが出る）になるため get(key, default) を使う。
    function myLineId() {
      return request.auth.token.get('lineId', null);
    }
    // 既存ドキュメントの所有者か（lineId フィールド一致）。
    // 匿名では myLineId() が null になるため、isSignedIn() だけで判定すると
    // lineId を持たない（または null の）ドキュメントで null == null が成立してしまう。
    // 必ず検証済み LINE クレームを要求する。
    function ownsDoc() {
      return isLineUser() && resource.data.get('lineId', null) == myLineId();
    }
    // これから書き込むドキュメントの lineId が自分のものか（同上の理由で isLineUser 必須）。
    function writingAsSelf() {
      return isLineUser() && request.resource.data.get('lineId', null) == myLineId();
    }
    // 支出ドキュメントが属するアプリ内グループのID（無ければ null）。
    // 直接 resource.data.groupId を参照すると、フィールドを持たないドキュメントで
    // 評価エラーになるため get(key, default) を使う。
    function docGroupId() {
      return resource.data.get('groupId', null);
    }
    // そのグループの有効なメンバーか。
    //
    // groupMembers のドキュメントIDは bot/src/firestore.ts の groupMemberDocId() と
    // 同じ規則（`${groupId}_${lineId}`）で組み立てる。変更する場合は
    // scripts/migrate-group-members.mjs も併せて更新すること。
    //
    // exists() と get() は同一パスならキャッシュされ、1評価あたり10回という
    // ドキュメントアクセス上限にも1回としてしか数えられない。支出一覧のように
    // 数百件を返すクエリでも、参照先は「自分の当該グループのメンバー文書」1つに
    // 収まるため上限にも課金にも影響しない。
    //
    // 【重要】list（クエリ）はドキュメントを1件ずつ評価するのではなく、
    // 「クエリの制約からルールを満たすと証明できるか」で判定される。したがって
    // ルールが参照するフィールドを、クエリが等値で制約していなければ拒否される。
    // グループ支出は必ず where('groupId','==',…) で引くこと
    // （where('lineGroupId','==',…) では groupId を証明できず拒否される）。
    function isMemberOf(groupId) {
      return isLineUser()
             && groupId != null
             && exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + myLineId()))
             && get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + myLineId())).data.get('isActive', false) == true;
    }
    // 対象ドキュメントのグループのメンバーか。
    function isMemberOfDocGroup() {
      return isMemberOf(docGroupId());
    }
    // Gmail 自動取込がシステムユーザーとして登録した支出か。
    // bot/src/gmail/handler.ts の GMAIL_SYSTEM_LINE_ID と一致させること。
    function isGmailSystemDoc() {
      return resource.data.get('lineId', null) == 'gmail-auto-system';
    }
    // ---- 支出の検証ヘルパー ----------------------------------------------
    // 金額の上限（円）。bot の登録経路はいずれも 0 以上の整数・実額で書き込む。
    // 負の金額（調整エントリ）はクライアントからは作らせない。
    function validAmount(v) {
      return v is number && v >= 0 && v <= 10000000;
    }
    function validDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    // レシート URL は Firebase Storage のダウンロード URL に限る（外部 URL の埋め込み防止）。
    function validReceiptUrl(v) {
      return validStr(v, 2048)
             && v.matches('^https://firebasestorage[.]googleapis[.]com/.*');
    }
    // 変更されたキー（create は全キー）だけを検証する。既存データに上限を超える
    // 値が残っていても、そのフィールドに触れない編集は通す。
    function expenseFieldsValid(d, changed) {
      return (!('amount' in changed) || validAmount(d.amount))
          && (!('date' in changed) || validDate(d.date))
          && (!('description' in changed) || validStr(d.description, 500))
          && (!('category' in changed) || validStr(d.category, 50))
          && (!('includeInTotal' in changed) || d.includeInTotal is bool)
          && (!('payerId' in changed) || (validStr(d.payerId, 128) && d.payerId.size() > 0))
          && (!('payerDisplayName' in changed) || validStr(d.payerDisplayName, 100))
          && (!('userDisplayName' in changed) || validStr(d.userDisplayName, 100))
          && (!('paymentMethod' in changed) || validStr(d.paymentMethod, 20))
          && (!('receiptUrl' in changed) || validReceiptUrl(d.receiptUrl))
          && (!('status' in changed) || d.status in ['pending', 'shared', 'personal'])
          && (!('groupId' in changed) || validStr(d.groupId, 128))
          && (!('lineGroupId' in changed) || validStr(d.lineGroupId, 128))
          && (!('createdAt' in changed) || d.createdAt is timestamp)
          && (!('updatedAt' in changed) || d.updatedAt is timestamp);
    }
    // web から編集できるフィールド（許可リスト）。
    //   - 編集ドロワー（web/app/expenses/page.tsx の handleEditSave → web/lib/hooks.ts の
    //     updateExpense）: amount / description / date / category / includeInTotal /
    //     payerId / payerDisplayName / updatedAt
    //   - 合計に含めるトグル: includeInTotal / updatedAt
    //   - レシート添付（web/app/attach/page.tsx）: receiptUrl / updatedAt
    // lineId / groupId / lineGroupId / createdAt / inputSource / status / advanceBy /
    // advanceSettledAt / gmailMessageId / appUid などは不変（変更は bot = Admin SDK だけ）。
    // web で編集対象を増やすときは、ここと test/firestore.rules.test.mjs を更新すること。
    function editableExpenseKeys() {
      return ['amount', 'description', 'date', 'category', 'includeInTotal',
              'payerId', 'payerDisplayName', 'receiptUrl', 'updatedAt'];
    }
    // クライアントが作成時に書けるフィールド。inputSource / gmailMessageId / advanceBy /
    // appUid などは bot 専用（Gmail 取込の重複判定や精算・userLinks 同期に使われるため
    // クライアントに偽装させない）。
    function creatableExpenseKeys() {
      return ['lineId', 'groupId', 'lineGroupId', 'userDisplayName', 'amount',
              'description', 'date', 'category', 'includeInTotal', 'status',
              'payerId', 'payerDisplayName', 'paymentMethod', 'createdAt', 'updatedAt'];
    }
    // 精算済み（立替を精算した）支出か。精算額が後から変わらないよう、
    // クライアントからは金額・日付・支払者の変更と削除を禁止する（status はそもそも不変）。
    function isSettledDoc() {
      return resource.data.get('status', null) == 'advance_settled';
    }
    // 精算済みの支出で変更できないフィールド。精算額は「誰がいくら払ったか」から
    // 計算されるため、支払者（payerId / payerDisplayName）も精算記録の一部として固定する。
    function settledLockedKeys() {
      return ['amount', 'date', 'payerId', 'payerDisplayName'];
    }
    // 個人支出か（groupId も lineGroupId も持たない）。
    // groupId なしで lineGroupId だけを持つ旧形式の支出は LINE 側の集計に入るため、
    // 個人支出として所有者だけで書き換えられるようにはしない（脱退済みの元メンバーが
    // 世帯の LINE 集計に入る支出を書き換えられないようにする）。
    function isPersonalDoc() {
      return docGroupId() == null && resource.data.get('lineGroupId', null) == null;
    }
    // 作成しようとしている支出のグループ所属が正当か。
    //   - groupId なし: 個人支出。bot は lineGroupId だけで集計・精算するため、
    //     groupId を持たずに lineGroupId だけを持つ支出（web からは見えないのに LINE の
    //     集計に入る）は作らせない。
    //   - groupId あり: そのグループの有効なメンバーであり、lineGroupId を付けるなら
    //     グループに紐づく LINE グループと一致すること。
    function validExpenseGroupOnCreate(d) {
      return (!('groupId' in d) && !('lineGroupId' in d))
          || ('groupId' in d
              && isMemberOf(d.groupId)
              && (!('lineGroupId' in d)
                  || d.lineGroupId == get(/databases/$(database)/documents/groups/$(d.groupId)).data.get('lineGroupId', null)));
    }
    // 単一ドキュメントの書き込み（update / delete）で、呼び出し元がその支出を扱えるか。
    //   - グループ支出（groupId あり）: そのグループの有効なメンバーだけ。
    //     LINE グループを抜けて isActive:false になった元メンバーは、自分が登録した
    //     支出でも書き換えられない。
    //   - 個人支出（groupId も lineGroupId もなし）: 所有者だけ。
    //   - groupId なしで lineGroupId だけを持つ旧形式: クライアントからは書き換えられない。
    function canWriteExistingExpense() {
      return (isPersonalDoc() && ownsDoc()) || isMemberOfDocGroup();
    }

    // ---- expenses -----------------------------------------------------------
    // 支出。個人支出は lineId フィールドで所有者を持つ。グループ支出は
    // lineGroupId / groupId フィールドを併せ持つ。
    match /expenses/{expenseId} {
      // read:
      //   - 所有者（resource.data.lineId == myLineId()）は常に読める。
      //   - グループ支出は、そのグループの有効なメンバーだけが読める。
      // groupMembers を決定的ID（`${groupId}_${lineId}`）へ移行したことで、
      // 「呼び出し元が当該グループのメンバーか」を exists()/get() で検証できるように
      // なった。従来の「LINE 本人確認済みなら誰でも読める」状態はここで解消される。
      //
      // 【注】所有者の read は groupId の有無を問わない。web の個人支出クエリは
      //   where('lineId','==',自分) で引くため、ここに groupId の条件を足すと
      //   クエリがルールで証明できず一覧全体が拒否される。
      allow read: if ownsDoc() || isMemberOfDocGroup();

      // create: LINE 本人確認済みで、自分の lineId を持ち、許可されたフィールドだけで、
      // 値が妥当で、グループ所属が正当な場合のみ。
      // （現状 web は支出を作成しない。登録は bot = Admin SDK が行う）
      // （writingAsSelf() は isLineUser() を含む）
      allow create: if writingAsSelf()
                    && request.resource.data.keys().hasAll(['lineId', 'amount', 'date'])
                    && request.resource.data.keys().hasOnly(creatableExpenseKeys())
                    && expenseFieldsValid(request.resource.data, request.resource.data.keys())
                    && validExpenseGroupOnCreate(request.resource.data);

      // update: 扱える支出について、許可リストのフィールドだけを、妥当な値で変更できる。
      //   Gmail 自動取込の支出は lineId が固定のシステムユーザー
      //   ('gmail-auto-system') であり、どの実ユーザーの lineId とも一致しないため、
      //   グループメンバーであれば修正できる（LINE カードの「修正」導線）。
      //   精算済みの支出は金額・日付・支払者を変えられない。
      allow update: if canWriteExistingExpense()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableExpenseKeys())
                    && expenseFieldsValid(request.resource.data,
                                          request.resource.data.diff(resource.data).affectedKeys())
                    && (!isSettledDoc()
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(settledLockedKeys()));

      // delete:
      //   - 個人支出（groupId も lineGroupId もなし）は所有者が削除可。
      //   - グループ支出は、有効なメンバーのうち、登録した本人か、Gmail 自動取込分
      //     （誤取込メールを消すため）の場合だけ削除可。
      //   - 精算済みの支出はクライアントから削除できない。
      allow delete: if !isSettledDoc()
                    && ((isPersonalDoc() && ownsDoc())
                        || (isMemberOfDocGroup() && (ownsDoc() || isGmailSystemDoc())));
    }

    // ---- groups -------------------------------------------------------------
    // 共有家計グループ。createdBy に作成者の LINE userId、inviteCode に参加用コードを持つ。
    // 作成・参加・メンバー追加はすべて Bot（Admin SDK）が行い、ルールをバイパスする。
    match /groups/{groupId} {
      // read: そのグループのメンバーのみ。inviteCode を含むため、非メンバーには見せない。
      //
      // 判定にパスのワイルドカード {groupId} を使うため、これは単一ドキュメント取得
      // （getDoc）専用の条件になる。list はクエリ制約からの証明が必要で、
      // ドキュメントIDはクエリ制約に現れないため必ず拒否される。web は所属を
      // groupMembers から解決して getDoc するのでこれで足りる。
      allow read: if isMemberOf(groupId);

      // write: クライアントからは全面禁止（Admin SDK はバイパスする）。
      // web はグループを読み取るだけで作成・更新しない。createdBy を自分にすれば
      // 作成できる従来の条件は、メンバーシップが権限判定に使われる今となっては
      // 「自分が作成者のグループを勝手に生やせる」入口になるため塞ぐ。
      allow write: if false;
    }

    // ---- groupMembers -------------------------------------------------------
    // グループメンバーシップ。ドキュメントIDは `${groupId}_${lineId}`（決定的）。
    // 追加・更新はすべて Bot（Admin SDK）が行い、ルールをバイパスする。
    match /groupMembers/{memberId} {
      // read:
      //   - 自分のメンバーシップ（useGroupMembers 相当の where('lineId','==',自分)）。
      //   - 同じグループのメンバーであれば他メンバーの行も読める
      //     （メンバー一覧の where('groupId','==',…) がこれに当たる）。
      allow read: if isLineUser()
                  && (resource.data.get('lineId', null) == myLineId()
                      || isMemberOf(resource.data.get('groupId', null)));

      // write: クライアントからは全面禁止（Admin SDK はバイパスする）。
      // メンバーシップが権限判定の根拠になったため、自己登録を許すと
      // 「任意のグループのメンバー文書を自分で作る → そのグループの家計簿を読む」
      // という権限昇格が成立してしまう。web は groupMembers に書き込まない。
      allow write: if false;
    }

    // ---- userSettings / budgetSettings / dateRangeSettings ------------------
    // いずれもドキュメント ID = 利用者の LINE userId（web は user.uid=lineId を doc-id に使う）。
    // 自分の設定ドキュメントのみ read/write 可。
    match /userSettings/{lineId} {
      allow read, write: if isSignedIn() && lineId == myLineId();
    }
    match /budgetSettings/{lineId} {
      allow read, write: if isSignedIn() && lineId == myLineId();
    }
    match /dateRangeSettings/{lineId} {
      allow read, write: if isSignedIn() && lineId == myLineId();
    }

    // ---- userLinks ----------------------------------------------------------
    // appUid → lineId のリンク。ドキュメント ID = appUid。
    // read: 本人の appUid のドキュメントのみ。
    // write: クライアントからは禁止（Admin SDK はバイパスする）。web は書き込まない。
    //   bot は lineId から appUid を引くのに lineIds の array-contains で検索するため、
    //   クライアントが任意の lineIds を持つドキュメントを作れると、他人の lineId に
    //   対する appUid 解決を汚染できてしまう。
    match /userLinks/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- linkTokens ---------------------------------------------------------
    // アカウント連携トークン。Bot（Admin SDK）のみが読み書きし、Admin SDK は
    // ルールをバイパスする。クライアントからのアクセスは全面禁止。
    match /linkTokens/{tokenId} {
      allow read, write: if false;
    }

    // ---- デフォルト拒否 ------------------------------------------------------
    // 明示的に許可されていないすべてのパス（userCustomCategories / categoryFeedback
    // など Bot/Admin SDK 専用コレクションを含む）はクライアントから拒否する。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
