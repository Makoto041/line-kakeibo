{
  "functions": [
    {
      "source": "bot",
      "codebase": "default",
      "runtime": "nodejs22",
      "region": "asia-northeast1",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local.json",
        "**/scripts/eval/results",
        "kakeibo_service.json",
        "vision-key.json",
        "*.b64",
        "*-debug.log",
        ".env.local",
        ".env.production"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
